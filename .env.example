# Chave gratuita do OpenRouteService (openrouteservice.org/dev/#/signup)
ORS_API_KEY=coloque_sua_chave_aqui

# Caminho para o JSON da service account do Google (ver README para criar)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# ID da planilha Google Sheets (fica na URL entre /d/ e /edit)
GOOGLE_SHEET_ID=coloque_o_id_da_planilha_aqui

# Nome da aba dentro da planilha
GOOGLE_WORKSHEET_NAME=Rotas
